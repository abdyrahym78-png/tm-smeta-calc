datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model NormativeBase {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  rates       Rate[]
  createdAt   DateTime @default(now())
}

model Rate {
  id              String                 @id @default(uuid())
  code            String                 @unique
  name            String
  basePrice       Float
  currency        String
  countryCode     String
  regionId        String?
  normativeBaseId String
  normativeBase   NormativeBase          @relation(fields: [normativeBaseId], references: [id])
  bimMappings     ClassificationMapping[]
  estimateItems   EstimateItem[]
  createdAt       DateTime               @default(now())
}

model ClassificationMapping {
  id        String   @id @default(uuid())
  bimSystem String
  bimCode   String
  rateId    String
  rate      Rate     @relation(fields: [rateId], references: [id])

  @@index([bimSystem, bimCode])
}

model Project {
  id        String     @id @default(uuid())
  name      String
  client    String?
  regionId  String?
  estimates Estimate[]
  createdAt DateTime   @default(now())
}

model Estimate {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  totalAmount Float          @default(0.0)
  currency    String         @default("TMT")
  items       EstimateItem[]
  createdAt   DateTime       @default(now())
}

model EstimateItem {
  id            String   @id @default(uuid())
  estimateId    String
  estimate      Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  rateId        String?
  rate          Rate?    @relation(fields: [rateId], references: [id])
  quantity      Float
  unitPrice     Float
  locationCoeff Float    @default(1.0)
  taxRate       Float    @default(0.0)
  overheadCoeff Float    @default(1.0)
  totalPrice    Float
}
